{
	"name": "wsmc",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"demo:preview": "bash scripts/demo-preview.sh",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:db": "bash scripts/test-v2-db.sh",
		"test:qualifications": "node scripts/test-qualification-workflow.mjs",
		"rehearsal": "bash scripts/dress-rehearsal.sh",
		"test:e2e:preview": "bash scripts/e2e-preview.sh",
		"smoke:preview": "bash scripts/smoke-preview.sh",
		"seed": "wrangler d1 execute wsmc-db --local --file=scripts/seed.sql",
		"seed:remote": "wrangler d1 execute wsmc-db --remote --file=scripts/seed.sql",
		"seed:first-season": "bash scripts/seed-scenario.sh first-season",
		"seed:new-season": "bash scripts/seed-scenario.sh new-season",
		"seed:showcase": "bash scripts/seed-showcase.sh"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260312.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.5",
		"devalue": "^5.9.4",
		"drizzle-kit": "^0.31.9",
		"miniflare": "^4.20260310.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"wrangler": "^4.72.0"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.1",
		"qrcode-generator": "^2.0.4"
	}
}
